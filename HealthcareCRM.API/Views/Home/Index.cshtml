        <div class="hero-actions">
            <a class="hero-btn hero-btn-primary" href="/Appointment/Create">Book Appointment →</a>
            <a class="hero-btn hero-btn-secondary" href="/Doctor">Learn More</a>
        </div>

        <div class="hero-trust">
            <div class="trust-avatars">
    <img src="/assets/Images/doctor2.jpg" alt="Staff" class="trust-avatar-img" />
    <img src="/assets/Images/doctor4.jpg" alt="Staff" class="trust-avatar-img" />
    <img src="/assets/Images/doctor5.jpg" alt="Staff" class="trust-avatar-img" />
</div>
            <div class="trust-text">
                <span class="trust-stars">★★★★★</span>
                <span id="trustCount">Loading trusted by staff...</span>
            </div>
        </div>
    </div>

   <div class="hero-right">
    <img src="/assets/Images/doctor1.jpg" alt="Doctor" class="hero-image" />
</div>
</div>

<div class="feature-strip">
    <div class="feature-item">
        <div class="feature-icon">👥</div>
        <p class="feature-label">Patient Records</p>
    </div>
    <div class="feature-item">
        <div class="feature-icon">📅</div>
        <p class="feature-label">Easy Scheduling</p>
    </div>
    <div class="feature-item">
        <div class="feature-icon">🩺</div>
        <p class="feature-label">Doctor Management</p>
    </div>
    <div class="feature-item">
        <div class="feature-icon">📊</div>
        <p class="feature-label">Live Insights</p>
    </div>
    <div class="feature-item">
        <div class="feature-icon">🔒</div>
        <p class="feature-label">Secure Access</p>
    </div>
</div>

<div class="stats-bar">
    <div class="stat-item">
        <p class="stat-number" id="statDoctors">-</p>
        <p class="stat-caption">Active Doctors</p>
    </div>
    <div class="stat-item">
        <p class="stat-number" id="statPatients">-</p>
        <p class="stat-caption">Registered Patients</p>
    </div>
    <div class="stat-item">
        <p class="stat-number" id="statAppointments">-</p>
        <p class="stat-caption">Appointments This Week</p>
    </div>
</div>

<div class="about-section">
    <div class="about-image">
    <img src="/assets/Images/doctor3.webp" alt="Doctor with patient" />
</div>
    <div class="about-content">
        <p class="hero-eyebrow">About Us</p>
        <h2>We're Here for You and Your Team</h2>
        <p class="about-text">Our mission is to give your clinic a simple, reliable way to manage patients, doctors, and appointments — all in one organized place.</p>
        <ul class="about-checklist">
            <li>✓ Organized patient records</li>
            <li>✓ Fast, reliable scheduling</li>
            <li>✓ Secure, role-based access</li>
        </ul>
    </div>
</div>

<div class="benefits-section">
    <h2 class="benefits-title">Why teams choose this CRM</h2>

    <div class="benefits-grid">
        <div class="benefit-card">
            <div class="benefit-icon benefit-icon-blue">📋</div>
            <h3>Organized Records</h3>
            <p>All patient and doctor information stored in one searchable place.</p>
        </div>

        <div class="benefit-card">
            <div class="benefit-icon benefit-icon-green">🗓️</div>
            <h3>Easy Scheduling</h3>
            <p>Book, confirm, and cancel appointments in just a few clicks.</p>
        </div>

        <div class="benefit-card">
            <div class="benefit-icon benefit-icon-yellow">🩺</div>
            <h3>Doctor Management</h3>
            <p>Track specializations, schedules, and availability at a glance.</p>
        </div>

        <div class="benefit-card">
            <div class="benefit-icon benefit-icon-blue">🔒</div>
            <h3>Secure Access</h3>
            <p>Only authorized staff can log in and view sensitive patient data.</p>
        </div>
    </div>
</div>

<script>
    if (!token) {
        window.location.href = "/Account/Login";
    }

    async function loadHomeStats() {
        try {
            const response = await fetch("/api/home-stats", {
                headers: { "Authorization": `Bearer ${token}` }
            });

            if (!response.ok) {
                document.getElementById("trustCount").innerText = "";
                return;
            }

            const result = await response.json();
            const stats = result.data;

            document.getElementById("statDoctors").innerText = stats.activeDoctors;
            document.getElementById("statPatients").innerText = stats.totalPatients;
            document.getElementById("statAppointments").innerText = stats.appointmentsThisWeek;
            document.getElementById("trustCount").innerText = `Trusted by ${stats.activeDoctors}+ doctors on staff`;
        } catch {
            document.getElementById("trustCount").innerText = "";
        }
    }

    loadHomeStats();
</script>