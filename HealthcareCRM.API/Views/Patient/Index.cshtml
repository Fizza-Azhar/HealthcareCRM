@{
    ViewData["Title"] = "Patient List";
}

<link rel="stylesheet" href="~/css/patient.css" />

<h2>Patient List</h2>

<input type="text" id="searchBox" placeholder="Search by name or phone" />

<br />
<br />

<a href="/Patient/Create">Add New Patient</a>

<br />
<br />

<table id="patientsTable">
    <thead>
        <tr>
            <th>Id</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
    </tbody>
</table>
<br />

<button onclick="previousPage()">Previous</button>

<span id="pageNumber">Page 1</span>

<button onclick="nextPage()">Next</button>

<script>
    const token = localStorage.getItem("token");
    let currentPage = 1;
    const pageSize = 5;

    if (!token) {
        window.location.href = "/Account/Login";
    }

    async function loadPatients(page = 1) {
        currentPage = page;

        const search = document.getElementById("searchBox").value;

        const response = await fetch(`/api/patients?search=${search}&page=${currentPage}&pageSize=${pageSize}`);

        const patients = await response.json();

        const tableBody = document.querySelector("#patientsTable tbody");

        tableBody.innerHTML = "";
        if (patients.length === 0) {
    tableBody.innerHTML = `
        <tr>
            <td colspan="8" style="text-align:center;">
                No patients found.
            </td>
        </tr>
    `;
    return;
}

        patients.forEach(patient => {

            tableBody.innerHTML += `
<tr>
    <td>${patient.id}</td>
    <td>${patient.firstName}</td>
    <td>${patient.lastName}</td>
    <td>${patient.age}</td>
    <td>${patient.gender}</td>
    <td>${patient.phoneNumber}</td>
    <td>${patient.email}</td>
    <td>
        <button onclick="editPatient(${patient.id})">Edit</button>
        <button onclick="deletePatient(${patient.id})">Delete</button>
    </td>
</tr>
`;
        });
    }

    async function deletePatient(id) {

        if (!confirm("Are you sure you want to delete this patient?")) {
            return;
        }

        await fetch(`/api/patients/${id}`, {
            method: "DELETE"
        });

        loadPatients();
    }

    function editPatient(id) {

        window.location.href = "/Patient/Edit?id=" + id;

    }

    // Search automatically while typing
    document.getElementById("searchBox").addEventListener("keyup", function () {
    loadPatients(1);
});

// Next Page
function nextPage() {
    currentPage++;
    document.getElementById("pageNumber").innerText = "Page " + currentPage;
    loadPatients(currentPage);
}

// Previous Page
function previousPage() {

    if (currentPage > 1) {
        currentPage--;
        document.getElementById("pageNumber").innerText = "Page " + currentPage;
        loadPatients(currentPage);
    }
}

// Load first page
loadPatients();

</script>