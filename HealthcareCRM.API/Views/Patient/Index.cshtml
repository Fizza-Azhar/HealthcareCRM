@{
    ViewData["Title"] = "Patient List";
}

<link rel="stylesheet" href="~/css/patient.css" />

<h2>Patient List</h2>
<p class="page-subtitle">View, search, and manage registered patients.</p>

<div class="toolbar">
    <input type="text" id="searchBox" placeholder="Search by name or phone" />
    <a class="btn-add" href="/Patient/Create">+ Add New Patient</a>
</div>

<div class="table-card">
    <table id="patientsTable">
        <thead>
            <tr>
                <th>Id</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Age</th>
                <th>Gender</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<div class="pagination">
    <button onclick="previousPage()">Previous</button>
    <span id="pageNumber">Page 1</span>
    <button onclick="nextPage()">Next</button>
</div>

<script>
    const token = localStorage.getItem("token");
    let currentPage = 1;
    const pageSize = 5;

    if (!token) {
        window.location.href = "/Account/Login";
    }

    async function loadPatients(page = 1) {
        currentPage = page;

        const search = document.getElementById("searchBox").value;

        const response = await fetch(`/api/patients?search=${search}&page=${currentPage}&pageSize=${pageSize}`, {
            headers: {
                "Authorization": `Bearer ${token}`
            }
        });

        const tableBody = document.querySelector("#patientsTable tbody");

        if (!response.ok) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="8" class="empty-state">
                        Failed to load patients. Please try again.
                    </td>
                </tr>
            `;
            return;
        }

        const patients = await response.json();

        tableBody.innerHTML = "";
        if (patients.length === 0) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="8" class="empty-state">
                        No patients found.
                    </td>
                </tr>
            `;
            return;
        }

        patients.forEach(patient => {
            tableBody.innerHTML += `
<tr>
    <td>${patient.id}</td>
    <td>${patient.firstName}</td>
    <td>${patient.lastName}</td>
    <td>${patient.age}</td>
    <td>${patient.gender}</td>
    <td>${patient.phoneNumber}</td>
    <td>${patient.email}</td>
    <td>
        <button onclick="viewPatient(${patient.id})">View</button>
        <button onclick="editPatient(${patient.id})">Edit</button>
        <button onclick="deletePatient(${patient.id})">Delete</button>
    </td>
</tr>
`;
        });
    }

    async function deletePatient(id) {
        if (!confirm("Are you sure you want to delete this patient?")) {
            return;
        }

        await fetch(`/api/patients/${id}`, {
            method: "DELETE",
            headers: {
                "Authorization": `Bearer ${token}`
            }
        });

        loadPatients();
    }

    function viewPatient(id) {
        window.location.href = "/Patient/Details?id=" + id;
    }

    function editPatient(id) {
        window.location.href = "/Patient/Edit?id=" + id;
    }

    document.getElementById("searchBox").addEventListener("keyup", function () {
        loadPatients(1);
    });

    function nextPage() {
        currentPage++;
        document.getElementById("pageNumber").innerText = "Page " + currentPage;
        loadPatients(currentPage);
    }

    function previousPage() {
        if (currentPage > 1) {
            currentPage--;
            document.getElementById("pageNumber").innerText = "Page " + currentPage;
            loadPatients(currentPage);
        }
    }

    loadPatients();
</script>