@{
    ViewData["Title"] = "Appointments";
}


<h2>Appointments</h2>
<p class="page-subtitle">All scheduled appointments in the system.</p>

<div class="toolbar">
    <select id="statusFilter">
        <option value="">All Statuses</option>
        <option value="Pending">Pending</option>
        <option value="Confirmed">Confirmed</option>
        <option value="Cancelled">Cancelled</option>
    </select>
    <button id="exportPdfBtn" class="btn-cancel" style="display:none;">Export PDF Report</button>
    <a href="/Appointment/Create" class="btn-add">+ Book Appointment</a>
</div>

<div class="table-card">
    <table id="appointmentsTable">
        <thead>
            <tr>
                <th>Id</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Date/Time</th>
                <th>Status</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<script>

    if (!token) {
        window.location.href = "/Account/Login";
    }

    function getInitials(name) {
        return name.split(" ").map(w => w[0]).join("").toUpperCase().slice(0, 2);
    }

    async function loadAppointments(status = "") {
    const tableBody = document.querySelector("#appointmentsTable tbody");
    tableBody.innerHTML = `
        <tr class="spinner-row">
            <td colspan="7"><div class="spinner"></div></td>
        </tr>
    `;

    const url = status
        ? `/api/appointments?status=${status}`
        : `/api/appointments`;

    const response = await fetch(url, {
        headers: {
            "Authorization": `Bearer ${token}`
        }
    });
        if (!response.ok) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="7" class="empty-state">
                        Failed to load appointments. Please try again.
                    </td>
                </tr>
            `;
            return;
        }

        const result = await response.json();
        const appointments = result.data || [];

        tableBody.innerHTML = "";

        if (appointments.length === 0) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="7" class="empty-state">
                        No appointments found.
                    </td>
                </tr>
            `;
            return;
        }

        appointments.forEach(appt => {
            const patientName = appt.patient ? `${appt.patient.firstName} ${appt.patient.lastName}` : "Unknown";;
            const doctorName = appt.doctor ? appt.doctor.name : "Unknown";
            const dateTime = new Date(appt.dateTime).toLocaleString();

            tableBody.innerHTML += `
<tr>
    <td>${appt.id}</td>
    <td class="name-cell"><span class="avatar-circle">${getInitials(patientName)}</span>${patientName}</td>
    <td class="name-cell"><span class="avatar-circle">${getInitials(doctorName)}</span>${doctorName}</td>
    <td>${dateTime}</td>
    <td><span class="tag ${appt.status === 'Confirmed' ? 'tag-green' : appt.status === 'Cancelled' ? 'tag-red' : 'tag-yellow'}">${appt.status}</span></td>
    <td>${appt.notes || "-"}</td>
    <td>
    ${appt.status !== "Confirmed" ? `<button onclick="updateStatus(${appt.id}, 'Confirmed')">Confirm</button>` : ""}
    ${appt.status !== "Cancelled" ? `<button onclick="cancelAppointment(${appt.id})">Cancel</button>` : ""}
    <button onclick="deleteAppointment(${appt.id})" class="btn-danger">Delete</button>
</td>
</tr>
`;
        });
    }

    async function updateStatus(id, newStatus) {
        const response = await fetch(`/api/appointments/${id}/status`, {
            method: "PUT",
            headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${token}`
            },
            body: JSON.stringify({ status: newStatus })
        });

        if (response.ok) {
            loadAppointments(document.getElementById("statusFilter").value);
        } else {
            alert("Failed to update appointment status.");
        }
    }

    async function cancelAppointment(id) {
        if (!confirm("Cancel this appointment?")) return;
        await updateStatus(id, "Cancelled");
    }
    async function deleteAppointment(id) {
    if (!confirm("Delete this appointment permanently? This cannot be undone.")) return;

    const response = await fetch(`/api/appointments/${id}`, {
        method: "DELETE",
        headers: {
            "Authorization": `Bearer ${token}`
        }
    });

    if (response.ok) {
        loadAppointments(document.getElementById("statusFilter").value);
    } else {
        alert("Failed to delete appointment.");
    }
}

    document.getElementById("statusFilter").addEventListener("change", (e) => {
        loadAppointments(e.target.value);
    });
const decoded = token ? JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))) : null;
const role = decoded ? decoded["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] : null;

if (role === "Admin") {
    document.getElementById("exportPdfBtn").style.display = "inline-flex";
}

document.getElementById("exportPdfBtn").addEventListener("click", async () => {
    const response = await fetch("/api/export/appointments/report", {
        headers: { "Authorization": `Bearer ${token}` }
    });

    if (!response.ok) {
        alert("Failed to export appointment report.");
        return;
    }

    const blob = await response.blob();
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "appointment_report.pdf";
    document.body.appendChild(a);
    a.click();
    a.remove();
    window.URL.revokeObjectURL(url);
});

    loadAppointments();
</script>