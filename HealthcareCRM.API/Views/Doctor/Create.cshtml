@{
    ViewData["Title"] = "Add Doctor";
}



<div class="form-page-wrapper">
    <div class="form-page-inner">
        <h2>Add Doctor</h2>
        <p class="page-subtitle">Enter the doctor's details below.</p>

        <form id="createDoctorForm">
            <div class="form-grid">
                <div class="full-width">
                    <label>Name</label>
                    <input type="text" id="name" required />
                </div>

                <div>
                    <label>Specialization</label>
                    <input type="text" id="specialization" required />
                </div>

                <div>
                    <label>Phone</label>
                    <input type="text" id="phone" required />
                </div>

                <div class="full-width">
                    <label>Schedule Days</label>
                    <input type="text" id="scheduleDays" placeholder="e.g. Mon,Wed,Fri" required />
                </div>

                <div class="full-width">
                    <p id="errorMsg" class="error-text"></p>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit">Save Doctor</button>
                <a href="/Doctor/Index" class="btn-cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>

    if (!token) {
        window.location.href = "/Account/Login";
    }

    const form = document.getElementById("createDoctorForm");
    const errorMsg = document.getElementById("errorMsg");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorMsg.textContent = "";

        const doctor = {
            name: document.getElementById("name").value,
            specialization: document.getElementById("specialization").value,
            phone: document.getElementById("phone").value,
            scheduleDays: document.getElementById("scheduleDays").value
        };

        const response = await fetch("/api/doctors", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${token}`
            },
            body: JSON.stringify(doctor)
        });

        const result = await response.json();

        if (!response.ok) {
            errorMsg.textContent = result.message || "Failed to create doctor.";
            return;
        }

        window.location.href = "/Doctor/Index";
    });
</script>