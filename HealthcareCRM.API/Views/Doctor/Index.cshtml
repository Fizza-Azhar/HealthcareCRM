@{
    ViewData["Title"] = "Doctor List";
}


<h2>Doctor List</h2>
<p class="page-subtitle">Active doctors currently registered in the system.</p>
<div class="toolbar">
    <input type="text" id="searchBox" placeholder="Search doctors..." />
    <label id="showInactiveWrapper" style="display:none; align-items:center; gap:6px; font-size:14px;">
        <input type="checkbox" id="showInactive" /> Show inactive
    </label>
    <a href="/Doctor/Create" class="btn-add">+ Add Doctor</a>
</div>

<div class="table-card">
    <table id="doctorsTable">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Specialization</th>
                <th>Phone</th>
                <th>Schedule Days</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<script>

    if (!token) {
    window.location.href = "/Account/Login";
}

const decoded = token ? JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))) : null;
const role = decoded ? decoded["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] : null;

if (role === "Admin") {
    document.getElementById("showInactiveWrapper").style.display = "flex";
}

document.getElementById("showInactive")?.addEventListener("change", () => {
    loadDoctors();
});

let allDoctors = [];

    async function loadDoctors() {
    const tableBody = document.querySelector("#doctorsTable tbody");
    tableBody.innerHTML = `
        <tr class="spinner-row">
            <td colspan="6"><div class="spinner"></div></td>
        </tr>
    `;

    const showInactiveCheckbox = document.getElementById("showInactive");
    const includeInactive = showInactiveCheckbox ? showInactiveCheckbox.checked : false;

    const response = await fetch(`/api/doctors?includeInactive=${includeInactive}`, {
        headers: {
            "Authorization": `Bearer ${token}`
        }
    });

    if (!response.ok) {
        tableBody.innerHTML = `
            <tr>
                <td colspan="6" class="empty-state">
                    Failed to load doctors. Please try again.
                </td>
            </tr>
        `;
        return;
    }

    const result = await response.json();
    allDoctors = result.data || [];

    renderDoctors(allDoctors);
}

    function getInitials(name) {
        return name.split(" ").map(w => w[0]).join("").toUpperCase().slice(0, 2);
    }

    function renderDoctors(doctors) {
        const tableBody = document.querySelector("#doctorsTable tbody");
        tableBody.innerHTML = "";

        if (!doctors || doctors.length === 0) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="6" class="empty-state">
                        No doctors found.
                    </td>
                </tr>
            `;
            return;
        }

        doctors.forEach(doctor => {
    tableBody.innerHTML += `
<tr>
    <td>${doctor.id}</td>
    <td class="name-cell"><span class="avatar-circle">${getInitials(doctor.name)}</span>${doctor.name}</td>
    <td><span class="tag tag-blue">${doctor.specialization}</span></td>
    <td>${doctor.phone}</td>
    <td>${doctor.scheduleDays}</td>
    <td>
        <a href="/Doctor/Edit?id=${doctor.id}">Edit</a>
        ${doctor.isActive
            ? `<button onclick="deactivateDoctor(${doctor.id})">Deactivate</button>`
            : `<button onclick="reactivateDoctor(${doctor.id})">Reactivate</button>`}
    </td>
</tr>
`;
});
    }

    async function deactivateDoctor(id) {
    if (!confirm("Deactivate this doctor?")) return;

    const response = await fetch(`/api/doctors/${id}/deactivate`, {
        method: "PUT",
        headers: {
            "Authorization": `Bearer ${token}`
        }
    });

    if (response.status === 403) {
        alert("You do not have permission to deactivate doctors. Admin access required.");
        return;
    }

    if (!response.ok) {
        alert("Failed to deactivate doctor.");
        return;
    }

    loadDoctors();
}
async function reactivateDoctor(id) {
    if (!confirm("Reactivate this doctor?")) return;

    const response = await fetch(`/api/doctors/${id}/reactivate`, {
        method: "PUT",
        headers: {
            "Authorization": `Bearer ${token}`
        }
    });

    if (response.status === 403) {
        alert("You do not have permission to reactivate doctors. Admin access required.");
        return;
    }

    if (!response.ok) {
        alert("Failed to reactivate doctor.");
        return;
    }

    loadDoctors();
}

    document.getElementById("searchBox").addEventListener("input", (e) => {
        const term = e.target.value.toLowerCase();
        const filtered = allDoctors.filter(d =>
            d.name.toLowerCase().includes(term) ||
            d.specialization.toLowerCase().includes(term)
        );
        renderDoctors(filtered);
    });

    loadDoctors();
</script>