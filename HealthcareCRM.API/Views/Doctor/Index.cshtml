@{
    ViewData["Title"] = "Doctor List";
}

<link rel="stylesheet" href="~/css/patient.css" />

<h2>Doctor List</h2>
<p class="page-subtitle">Active doctors currently registered in the system.</p>

<div class="table-card">
    <table id="doctorsTable">
        <thead>
           <tr>
    <th>Id</th>
    <th>Name</th>
    <th>Specialization</th>
    <th>Phone</th>
    <th>Schedule Days</th>
    <th>Actions</th>
    </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<script>
    const token = localStorage.getItem("token");

    if (!token) {
        window.location.href = "/Account/Login";
    }

    async function loadDoctors() {

        const response = await fetch("/api/doctors", {
            headers: {
                "Authorization": `Bearer ${token}`
            }
        });

        if (!response.ok) {
    const tableBody = document.querySelector("#doctorsTable tbody");
    tableBody.innerHTML = `
        <tr>
            <td colspan="6" class="empty-state">
                Failed to load doctors. Please try again.
            </td>
        </tr>
    `;
    return;
}

        const result = await response.json();
        const doctors = result.data; // unwrap { success, data, message }

        const tableBody = document.querySelector("#doctorsTable tbody");

        tableBody.innerHTML = "";

        if (!response.ok) {
    const tableBody = document.querySelector("#doctorsTable tbody");
    tableBody.innerHTML = `
        <tr>
            <td colspan="6" class="empty-state">
                Failed to load doctors. Please try again.
            </td>
        </tr>
    `;
    return;
}
        doctors.forEach(doctor => {
    tableBody.innerHTML += `
<tr>
    <td>${doctor.id}</td>
    <td>${doctor.name}</td>
    <td>${doctor.specialization}</td>
    <td>${doctor.phone}</td>
    <td>${doctor.scheduleDays}</td>
    <td>
        <a href="/Doctor/Edit?id=${doctor.id}">Edit</a>
        <button onclick="deactivateDoctor(${doctor.id})">Deactivate</button>
    </td>
</tr>
`;
});
    }

    loadDoctors();
    async function deactivateDoctor(id) {
    if (!confirm("Deactivate this doctor?")) return;

    const response = await fetch(`/api/doctors/${id}/deactivate`, { method: "PUT" });
    if (response.ok) {
        loadDoctors(); // refresh list
    } else {
        alert("Failed to deactivate doctor.");
    }
}
</script>