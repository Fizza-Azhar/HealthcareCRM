@{
    ViewData["Title"] = "Doctor List";
}


<h2>Doctor List</h2>
<p class="page-subtitle">Active doctors currently registered in the system.</p>

<div class="toolbar">
    <input type="text" id="searchBox" placeholder="Search doctors..." />
    <a href="/Doctor/Create" class="btn-add">+ Add Doctor</a>
</div>

<div class="table-card">
    <table id="doctorsTable">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Specialization</th>
                <th>Phone</th>
                <th>Schedule Days</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<script>
    const token = localStorage.getItem("token");

    if (!token) {
        window.location.href = "/Account/Login";
    }

    let allDoctors = [];

    async function loadDoctors() {
        const response = await fetch("/api/doctors", {
            headers: {
                "Authorization": `Bearer ${token}`
            }
        });

        const tableBody = document.querySelector("#doctorsTable tbody");

        if (!response.ok) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="6" class="empty-state">
                        Failed to load doctors. Please try again.
                    </td>
                </tr>
            `;
            return;
        }

        const result = await response.json();
        allDoctors = result.data || [];

        renderDoctors(allDoctors);
    }

    function renderDoctors(doctors) {
        const tableBody = document.querySelector("#doctorsTable tbody");
        tableBody.innerHTML = "";

        if (!doctors || doctors.length === 0) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="6" class="empty-state">
                        No active doctors found.
                    </td>
                </tr>
            `;
            return;
        }

        doctors.forEach(doctor => {
            tableBody.innerHTML += `
<tr>
    <td>${doctor.id}</td>
    <td>${doctor.name}</td>
    <td><span class="tag tag-blue">${doctor.specialization}</span></td>
    <td>${doctor.phone}</td>
    <td>${doctor.scheduleDays}</td>
    <td>
        <a href="/Doctor/Edit?id=${doctor.id}">Edit</a>
        <button onclick="deactivateDoctor(${doctor.id})">Deactivate</button>
    </td>
</tr>
`;
        });
    }

    async function deactivateDoctor(id) {
        if (!confirm("Deactivate this doctor?")) return;

        const response = await fetch(`/api/doctors/${id}/deactivate`, {
            method: "PUT",
            headers: {
                "Authorization": `Bearer ${token}`
            }
        });

        if (response.ok) {
            loadDoctors();
        } else {
            alert("Failed to deactivate doctor.");
        }
    }

    document.getElementById("searchBox").addEventListener("input", (e) => {
        const term = e.target.value.toLowerCase();
        const filtered = allDoctors.filter(d =>
            d.name.toLowerCase().includes(term) ||
            d.specialization.toLowerCase().includes(term)
        );
        renderDoctors(filtered);
    });

    loadDoctors();
</script>